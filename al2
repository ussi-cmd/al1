Algorithm SumDistinctElements

Variables
    A, B : arrays of integers
    n, m, i, j : integers
    found : boolean
    sum : integer

Begin
    sum ← 0

    // Check elements of Set 1
    For i ← 1 to n do
        found ← false

        For j ← 1 to m do
            If A[i] = B[j] then
                found ← true
            EndIf
        EndFor

        If found = false then
            sum ← sum + A[i]
        EndIf
    EndFor

    // Check elements of Set 2
    For i ← 1 to m do
        found ← false

        For j ← 1 to n do
            If B[i] = A[j] then
                found ← true
            EndIf
        EndFor

        If found = false then
            sum ← sum + B[i]
        EndIf
    EndFor

    Write(sum)
End




