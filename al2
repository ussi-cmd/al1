Function dot_product(v1, v2, n) : real

Variables
    i : integer
    ps : real

Begin
    ps ← 0

    For i ← 1 to n do
        ps ← ps + (v1[i] * v2[i])
    EndFor

    Return ps
End
Algorithm CheckOrthogonal

Variables
    v1, v2 : arrays of real
    n, pairs, i, j : integer
    ps : real

Begin

    Write("Enter number of vector pairs:")
    Read(pairs)

    For i ← 1 to pairs do

        Write("Enter dimension of vectors:")
        Read(n)

        Write("Enter elements of vector 1:")
        For j ← 1 to n do
            Read(v1[j])
        EndFor

        Write("Enter elements of vector 2:")
        For j ← 1 to n do
            Read(v2[j])
        EndFor

        ps ← dot_product(v1, v2, n)

        If ps = 0 then
            Write("The vectors are orthogonal")
        Else
            Write("The vectors are not orthogonal")
        EndIf

    EndFor

End